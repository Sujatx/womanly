FROM python:3.12-slim AS builder

WORKDIR /build

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libpq-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --upgrade pip setuptools wheel && \
    pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt && \
    find /wheels -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && \
    find /wheels -name "*.pyc" -delete 2>/dev/null || true

FROM python:3.12-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install only runtime dependencies (no build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && groupadd -r appuser \
    && useradd -r -g appuser appuser

# Install wheels from builder
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir /wheels/* && \
    rm -rf /wheels

# Copy application
COPY . /app

# Strip compiled files and debug symbols to reduce image size
RUN find /usr/local/lib/python3.12/site-packages -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/local/lib/python3.12/site-packages -name "*.pyc" -delete 2>/dev/null || true && \
    find /usr/local/lib/python3.12/site-packages -name "*.pyo" -delete 2>/dev/null || true && \
    find /usr/local/lib/python3.12/site-packages -name "*.so" -exec strip --strip-all {} + 2>/dev/null || true && \
    find /usr/lib -name "*.so*" -exec strip --strip-all {} + 2>/dev/null || true

RUN chmod +x /app/docker/entrypoint.prod.sh 2>/dev/null || true && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS http://localhost:8000/health || exit 1

ENTRYPOINT ["/app/docker/entrypoint.prod.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
